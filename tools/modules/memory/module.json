{
  "schema_version": 2,
  "id": "memory",
  "name": "Memory",
  "description": "Mémoire explicite SQLite et recherche de connaissances locales.",
  "version": "1.0.0",
  "entrypoint": "module.py:module",
  "capabilities": ["tools"],
  "tools": [
